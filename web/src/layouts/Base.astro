---
import '../styles/paleta.css';
import '../styles/pixel.css';
import { url, absoluta } from '../lib/rutas';
import PunteroPixel from '../components/PunteroPixel.astro';
import Ajustes from '../components/Ajustes.astro';
import BarraMovil from '../components/BarraMovil.astro';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Pantalla completa sin scroll de página (todo menos la portada). */
  fija?: boolean;
}
const {
  titulo,
  descripcion = 'Lutum, el mundo de barro. Enciclopedia del mundo de rol de Cristina.',
  fija = false,
} = Astro.props;
---
<!doctype html>
<html lang="es" data-crt="on">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo} · LUTUM</title>
  <meta name="description" content={descripcion} />
  <meta name="theme-color" content="#0A0410" />
  <link rel="icon" type="image/png" href={url('assets/ui/favicon.png')} />

  {/* Open Graph exige URLs absolutas: con una ruta relativa ni WhatsApp ni
      Discord ni Twitter enseñan nada. Astro.site + Astro.url dan el dominio. */}
  <link rel="canonical" href={absoluta(Astro.url.pathname)} />
  <meta property="og:site_name" content="LUTUM" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:title" content={`${titulo} · LUTUM`} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={absoluta(Astro.url.pathname)} />
  <meta property="og:image" content={absoluta(url('assets/og.png'))} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="LUTUM, el mundo de barro" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preload" as="font" type="font/woff2" crossorigin
        href={url('fonts/PressStart2P.woff2')} />
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href={url('fonts/VT323.woff2')} />

  <style is:global define:vars={{
    fuenteTitulo: `url('${url('fonts/PressStart2P.woff2')}')`,
    fuenteTexto:  `url('${url('fonts/VT323.woff2')}')`,
    cursorPx:     `url('${url('assets/ui/cursor.png')}')`,
    cursorMano:   `url('${url('assets/ui/mano.png')}')`,
  }}>
    /* font-display:block a propósito: con tipografías bitmap el «swap» enseña
       un instante de Arial y salta todo el maquetado. */
    @font-face{
      font-family:'PxTitulo';
      src:var(--fuenteTitulo) format('woff2');
      font-weight:400; font-style:normal; font-display:block;
    }
    @font-face{
      font-family:'PxTexto';
      src:var(--fuenteTexto) format('woff2');
      font-weight:400; font-style:normal; font-display:block;
    }

    /* El puntero también es pixel art. Se desactiva en pantallas táctiles,
       donde no hay puntero que valga, y con el ratón fino de siempre como
       respaldo por si la imagen no carga. */
    @media (hover:hover) and (pointer:fine){
      /* Primera vía: el cursor de CSS. Funciona en la mayoría de sitios y no
         cuesta nada, así que se deja como red de seguridad para cuando no
         haya JavaScript. */
      html{ cursor:var(--cursorPx) 1 1, auto }
      a, button, summary, label, [role="button"], input[type="checkbox"]{
        cursor:var(--cursorMano) 13 3, pointer;
      }
      [disabled], [aria-disabled="true"]{ cursor:var(--cursorPx) 1 1, not-allowed }

      /* Segunda vía: el puntero dibujado en la página. Cuando su script
         arranca marca el html y se apaga el del sistema, que en algunos
         entornos ni siquiera llegaba a cambiarse. */
      html.sin-cursor, html.sin-cursor *{ cursor:none !important }
    }
  </style>
</head>

<body class={fija ? 'fija' : ''}>
  <slot />

  <PunteroPixel />

  <div class="crt-vineta" aria-hidden="true"></div>
  <div class="crt-lineas" aria-hidden="true"></div>

  <Ajustes />
  <BarraMovil />

<style>
  body.fija{ height:calc(100svh - var(--barra)); overflow:hidden }

  /* ---------- hueco de la barra inferior del móvil ----------------------
     `--barra` es la altura que la barra le quita a la pantalla. Vale 0 en
     escritorio, así que las pantallas pueden restarla siempre sin condicionar
     nada: `height: calc(100svh - var(--barra))` funciona en los dos sitios.
     Es la única forma de que las nueve alturas fijas del sitio dejen de
     quedar tapadas por debajo sin llenarlo todo de consultas de medios.   */
  :global(:root){ --barra:0px }
  @media (max-width:720px){
    :global(:root){ --barra:calc(56px + env(safe-area-inset-bottom, 0px)) }
  }
  @media (max-width:900px) and (max-height:480px){
    :global(:root){ --barra:calc(44px + env(safe-area-inset-bottom, 0px)) }
  }

  /* La portada sí baja con scroll: necesita sitio al final para que el pie no
     se quede debajo de la barra. */
  body:not(.fija){ padding-bottom:var(--barra) }
</style>
</body>
</html>
