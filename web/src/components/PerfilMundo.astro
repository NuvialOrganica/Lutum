---
import { EJES } from '../data/mundo';
---

<section class="mundo" id="mundo">
  <header class="cabecera">
    <p class="px indice">ARCHIVO 01</p>
    <h2 class="px">PERFIL DEL MUNDO</h2>
  </header>

  <div class="tesis marco marco--doble">
    <span class="etiqueta">TESIS</span>
    <p>
      Lutum no fue diseñado. Fue el <b>resultado</b> de una diosa que empieza cosas,
      se aburre, las abandona a medias y luego llora por los destrozos.
      Todo su panteón es una lista de accidentes con nombre propio.
    </p>
  </div>

  <ol class="ejes">
    {EJES.map((eje) => (
      <li class="eje marco">
        <span class="num px">{eje.n}</span>
        <h3 class="px">{eje.titulo}</h3>
        <p set:html={eje.texto} />
      </li>
    ))}
  </ol>
</section>

<style>
  .mundo{
    position:relative; z-index:2;
    padding:var(--u16) var(--u6);
    max-width:1400px; margin:0 auto;
  }
  .cabecera{ margin-bottom:var(--u12) }
  .indice{ font-size:8px; color:var(--c08); letter-spacing:.3em; margin-bottom:var(--u4) }
  .cabecera h2{ font-size:24px; color:var(--c10); text-shadow:var(--u) var(--u) 0 var(--c05) }
  @media (min-width:720px){ .cabecera h2{ font-size:32px } }

  .tesis{ max-width:72ch; padding:var(--u6); margin-bottom:var(--u16) }
  .tesis p{ font-size:24px; line-height:1.34; color:var(--c10) }
  .tesis b{ color:var(--c08) }

  .ejes{
    list-style:none;
    display:grid; grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));
    gap:var(--u8);
  }
  .eje{ padding:var(--u6); position:relative; overflow:hidden }
  .eje .num{
    position:absolute; top:var(--u2); right:var(--u3);
    font-size:24px; color:var(--c02);
  }
  .eje h3{
    font-size:12px; line-height:1.7; color:var(--c10);
    margin-bottom:var(--u4); position:relative;
    max-width:calc(100% - var(--u8));
  }
  .eje p{ font-size:21px; line-height:1.32; color:var(--c09) }
  .eje :global(b){ color:var(--c10) }

  /* la tarjeta se «hunde» al pasar por encima, como un botón de consola */
  .eje{ transition:transform .12s steps(2) }
  .eje:hover{ transform:translate(2px,2px) }
</style>
