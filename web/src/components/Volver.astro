---
import { pagina } from '../lib/rutas';

interface Props {
  /** Ruta de destino, sin barras. Vacío = portada. */
  a?: string;
  texto: string;
  /**
   * Mantenerlo visible en el móvil. Por defecto se esconde: abajo hay barra
   * con las cinco secciones, así que un botón que lleva a una de ellas sobra
   * y encima roba la esquina de arriba. Sólo lo necesitan las fichas sueltas
   * de deidad, que no son ninguna de las cinco.
   */
  enMovil?: boolean;
}
const { a = '', texto, enMovil = false } = Astro.props;
---

<a class:list={['volver', 'px', { 'en-movil': enMovil }]} href={pagina(a)}>
  <span class="flecha" aria-hidden="true">◂</span>
  <span>{texto}</span>
</a>

<style>
  .volver{
    position:fixed; left:var(--u4); top:var(--u4); z-index:30;
    display:flex; align-items:center; gap:var(--u2);
    font-size:8px; letter-spacing:.16em; color:var(--c09);
    background:var(--c00); padding:var(--u3) var(--u4);
    box-shadow:0 0 0 2px var(--c05);
    transition:none;
  }
  .volver:hover{ color:var(--c00); background:var(--c13); box-shadow:0 0 0 2px var(--c10) }
  .volver:active{ transform:translate(2px,2px) }
  .flecha{ font-size:12px; line-height:1 }

  @media (max-width:720px){
    .volver:not(.en-movil){ display:none }
    /* El que se queda (la ficha de deidad) es el único camino de vuelta desde
       ahí, así que se pulsa cómodo. */
    .volver.en-movil{ min-height:44px }
  }
</style>
