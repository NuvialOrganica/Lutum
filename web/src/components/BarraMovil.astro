---
/**
 * La barra de abajo del móvil.
 *
 * En escritorio la navegación es diegética: no hay menú, hay objetos flotando
 * («Aquí no hay menú. Hay objetos.» dice la estantería). Una barra de pestañas
 * normal se cargaría esa premisa, así que aquí no hay pestañas: hay los mismos
 * cinco objetos, en pequeño. Es la estantería convertida en dique.
 *
 * Sólo existe por debajo de 720 px. Arriba de ahí no se pinta ni ocupa sitio.
 */
import SpritePx from './SpritePx.astro';
import { pagina } from '../lib/rutas';

const DESTINOS = [
  { id: 'mundo',   sprite: 'nav-mundo',   texto: 'MUNDO',   ruta: '' },
  { id: 'panteon', sprite: 'nav-panteon', texto: 'PANTEÓN', ruta: 'panteon' },
  { id: 'codice',  sprite: 'nav-codice',  texto: 'CÓDICE',  ruta: 'codice' },
  { id: 'cronica', sprite: 'nav-cronica', texto: 'CRÓNICA', ruta: 'cronica' },
  { id: 'lugares', sprite: 'nav-lugares', texto: 'LUGARES', ruta: 'lugares' },
] as const;

/**
 * Cuál está activo. Se calcula en compilación a partir de la ruta de la
 * página, no con JavaScript: así ya llega marcado en el HTML y no parpadea.
 *
 * Las fichas sueltas de deidad cuentan como panteón, que es de donde salen.
 */
const camino = Astro.url.pathname.replace(/\/$/, '');
const activo =
  DESTINOS.slice(1).find((d) => camino.endsWith(`/${d.ruta}`))?.id ??
  (camino.includes('/deidad/') ? 'panteon' : 'mundo');
---

<nav class="barra-movil" aria-label="Secciones">
  <ul>
    {DESTINOS.map((d) => (
      <li>
        <a
          href={pagina(d.ruta)}
          class:list={['destino', { activo: d.id === activo }]}
          aria-current={d.id === activo ? 'page' : undefined}
        >
          <SpritePx nombre={d.sprite} paleta={d.id === activo ? 'crema' : 'rosa'} tam={32} />
          <span class="px">{d.texto}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .barra-movil{ display:none }

  @media (max-width:720px){
    .barra-movil{
      display:block;
      position:fixed; left:0; right:0; bottom:0; z-index:80;
      background:var(--c00);
      /* borde duro arriba, nada de sombras difuminadas */
      box-shadow:0 -2px 0 var(--c05);
      /* La franja de gestos del iPhone se come lo que haya abajo del todo. */
      padding-bottom:env(safe-area-inset-bottom, 0px);
    }
    .barra-movil ul{
      list-style:none; margin:0; padding:0;
      display:grid; grid-template-columns:repeat(5, 1fr);
    }
    .destino{
      /* 56 px de alto: la zona que se pulsa es el enlace entero, no el icono.
         Por debajo de 44 se falla al apuntar con el pulgar. */
      min-height:56px;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      gap:2px; padding:var(--u2) 0 var(--u);
      color:var(--c09); text-decoration:none; transition:none;
    }
    .destino span{
      font-size:7px; letter-spacing:.06em; line-height:1;
      color:rgba(245,168,192,.55);
    }
    .destino :global(.sprite-px){ opacity:.55 }

    .destino.activo :global(.sprite-px){ opacity:1 }
    .destino.activo span{ color:var(--c13) }
    /* La marca del activo va arriba, pegada al borde: abajo la taparía la
       franja de gestos en los teléfonos que la tienen. */
    .destino.activo{ box-shadow:inset 0 3px 0 var(--c13) }

    .destino:active{ background:var(--c01) }
  }

  /* En horizontal un móvil es muy bajo; la barra se estrecha para no comerse
     media pantalla, y el texto sobra porque el icono ya está aprendido. */
  @media (max-width:900px) and (max-height:480px){
    .destino{ min-height:44px; flex-direction:row; gap:var(--u2) }
    .destino span{ display:none }
  }
</style>
