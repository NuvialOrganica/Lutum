---
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import PerfilMundo from '../components/PerfilMundo.astro';
import RecetaDivina from '../components/RecetaDivina.astro';
import Estanteria from '../components/Estanteria.astro';
import { url } from '../lib/rutas';
---

<Base titulo="El mundo de barro">
  <div class="nebulosa" style={`--fondo-img:url('${url('assets/fondos/fondo.png')}')`} aria-hidden="true"></div>

  <main>
    <Portada />
    <PerfilMundo />
    <RecetaDivina />
    <Estanteria />
  </main>

  <footer class="pie">
    <p class="px">LUTUM · UN MUNDO DE CRISTINA</p>
    <p class="px tenue">HECHO A MANO, PÍXEL A PÍXEL</p>
  </footer>
</Base>

<style>
  html{ scroll-behavior:smooth }

  /* La nebulosa de fondo, fija y muy apagada, para que todo el scroll ocurra
     sobre el mismo cielo. Se pone en un div y no en el body para poder
     escalarla sin arrastrar el contenido. */
  .nebulosa{
    position:fixed; inset:0; z-index:0; pointer-events:none;
    background:var(--fondo-img) center / cover;
    image-rendering:pixelated;
    opacity:.20;
  }
  main{ position:relative; z-index:1 }

  .pie{
    position:relative; z-index:2;
    text-align:center; padding:var(--u12) var(--u6) var(--u16);
    border-top:2px solid var(--c02);
  }
  .pie p{ font-size:8px; letter-spacing:.24em; color:rgba(245,168,192,.55); line-height:2.4 }
  .pie .tenue{ color:rgba(245,168,192,.28) }
</style>
